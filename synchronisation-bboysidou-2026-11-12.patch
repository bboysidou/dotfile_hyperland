+        if (!match) return "";
+        let id = "";
+        if (match[1].toLowerCase() === "youtu.be") id = match[2].split(/[?\/]/)[0];
+        else if (match[2].startsWith("watch?")) {
+            const query = match[2].slice(6).split('&');
+            const v = query.find(part => part.startsWith('v='));
+            if (v) id = v.slice(2);
+        } else {
