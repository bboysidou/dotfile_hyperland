new file mode 100644
index 0000000..11d0cb7
--- /dev/null
+++ b/quickshell/cassette/TestEngine.qml
@@ -0,0 +1,50 @@
+import QtQuick
+import QtMultimedia
+import Quickshell
+ShellRoot {
+    DeckEngine { id: engine }
+    property int stage: 0
+    property int ticks: 0
+    function check(ok, message) { if (!ok) { console.error("FAIL: " + message); Qt.exit(1); } }
+    Timer {
+        id: testTimer
+        interval: 100; running: true; repeat: true
+        onTriggered: {
+            ticks++;
+            if (ticks > 150) { console.error("FAIL timeout stage " + stage); Qt.exit(1); }
+            if (stage === 0) {
+                check(engine.time(65000) === "1:05", "time");
+                engine.load([]); check(engine.index === -1, "empty playlist");
+                engine.next(); engine.previous();
+                engine.openFolder("file:///tmp/cassette-test-audio"); stage++;
+            } else if (stage === 1 && !engine.scanning && engine.player.duration > 0) {
+                check(engine.tracks.length === 2, "folder filtering/count");
+                check(engine.player.duration === 4000, "duration");
+                check(engine.title === "Bande de test", "title metadata");
+                check(engine.artist === "Arch Test", "artist metadata");
+                engine.volume = 0.27; check(Math.abs(engine.volume - 0.27) < 0.001, "volume");
+                engine.play(); stage++;
+            } else if (stage === 2 && engine.playing) {
+                engine.player.position = 1500;
+                engine.player.pause(); stage++;
+            } else if (stage === 3 && engine.player.playbackState === MediaPlayer.PausedState) {
+                check(Math.abs(engine.player.position - 1500) < 300, "seek");
+                engine.stop(); stage++;
+            } else if (stage === 4) {
+                check(engine.player.position === 0 && !engine.playing, "stop resets");
+                engine.next(); stage++;
+            } else if (stage === 5 && engine.index === 1 && engine.playing) {
+                engine.previous(); stage++;
+            } else if (stage === 6 && engine.index === 0 && engine.playing) {
+                engine.choose(1, true); stage++;
+            } else if (stage === 7 && engine.index === 1 && engine.playing) {
+                engine.player.position = 3900; stage++;
+            } else if (stage === 8 && !engine.playing) {
+                engine.load(["file:///tmp/cassette-missing.wav"]); stage++;
+            } else if (stage === 9 && engine.error.length) {
+                console.log("PASS: folder, unicode URL, metadata, duration, volume, play/pause/stop, seek, next/previous, playlist end, invalid file");
+                testTimer.stop(); Qt.quit();
+            }
+        }
+    }
+}
diff --git a/quickshell/cassette/TestHistory.qml b/quickshell/cassette/TestHistory.qml
new file mode 100644
index 0000000..62871d4
--- /dev/null
+++ b/quickshell/cassette/TestHistory.qml
@@ -0,0 +1,27 @@
+import QtQuick
+import Quickshell
+ShellRoot {
+    YoutubeHistory { id: history }
+    function check(ok, message) { if (!ok) { console.error("FAIL history: " + message); Qt.exit(1); } }
+    function url(i) { return "https://www.youtube.com/watch?v=" + String(i).padStart(11, "0"); }
+    Timer {
+        interval: 100; running: true
+        onTriggered: {
+            if (Quickshell.env("CASSETTE_HISTORY_RELOAD") === "1") {
+                check(history.entries.length === 10, "persists after restart");
+                check(history.entries[0].url === url(4) && history.entries[0].title === "Titre été", "order and title persist");
+                console.log("HISTORY RELOAD PASS"); Qt.quit(); return;
+            }
+            check(history.entries.length === 0, "isolated initial state");
+            for (let i = 0; i < 12; i++) history.remember(url(i));
+            check(history.entries.length === 10, "limit 10");
+            check(history.entries[0].url === url(11) && history.entries[9].url === url(2), "newest first and eviction");
+            history.updateTitle(url(4), "Titre été"); history.remember(url(4));
+            check(history.entries.length === 10 && history.entries[0].title === "Titre été", "dedup and preserve title");
+            check(history.entries.filter(item => item.url === url(4)).length === 1, "no duplicate");
+            history.remember("invalid"); history.updateTitle(url(99), "unknown");
+            check(history.entries.length === 10 && history.entries[0].url === url(4), "reject invalid");
