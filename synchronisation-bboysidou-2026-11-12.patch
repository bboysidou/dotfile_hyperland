diff --git a/quickshell/system/qs-hwinfo b/quickshell/system/qs-hwinfo
new file mode 100755
index 0000000..6012eaa
--- /dev/null
+++ b/quickshell/system/qs-hwinfo
@@ -0,0 +1,87 @@
+#!/bin/sh
+set -eu
+
+OUT="${RUNTIME_DIRECTORY:-/run/qs-hw}"
+RAPL=/sys/class/powercap/intel-rapl:0
+SUPPLIES=/sys/class/power_supply
+INTERVAL_AC=2
+INTERVAL_BATTERY=6
+MICRO=1000000
+TENTH_WATT=100000
+
+publish() {
+    printf '%s\n' "$2" > "$OUT/$1.tmp"
+    mv -f "$OUT/$1.tmp" "$OUT/$1"
+}
+
+dimms() {
+    dmidecode -t memory | awk -F': ' '
+        function flush() {
+            if (size ~ /^[0-9]/)
+                printf "%s\t%s\t%s\t%s\n", loc, size, type, (configured != "" ? configured : speed)
+            loc = size = type = speed = configured = ""
+        }
+        /^Memory Device/ { flush(); next }
+        { sub(/^[ \t]+/, "") }
+        $1 == "Locator" { loc = $2 }
+        $1 == "Size" { size = $2 }
+        $1 == "Type" { type = $2 }
+        $1 == "Speed" { speed = $2 }
+        $1 == "Configured Memory Speed" { configured = $2 }
+        END { flush() }'
+}
+
+on_battery() {
+    mains=0
+    for supply in "$SUPPLIES"/*; do
+        read -r kind 2>/dev/null < "$supply/type" || continue
+        [ "$kind" = Mains ] || continue
+        read -r online 2>/dev/null < "$supply/online" || continue
+        [ "$online" = 1 ] && return 1
+        mains=1
+    done
+    [ "$mains" = 1 ]
+}
+
+umask 022
+mkdir -p "$OUT"
+publish dimms.tsv "$(dimms)"
+
+uncore_zone() {
+    for zone in "$RAPL"/intel-rapl:0:*; do
+        read -r name 2>/dev/null < "$zone/name" || continue
+        [ "$name" = uncore ] && { echo "$zone"; return; }
+    done
+}
+
+delta_of() {
+    delta=$(($2 - $1))
+    [ "$delta" -lt 0 ] && delta=$((delta + $3))
+    echo "$delta"
+}
+
+[ -r "$RAPL/energy_uj" ] || exit 0
+
+read -r range < "$RAPL/max_energy_range_uj"
+read -r prev < "$RAPL/energy_uj"
+
+UNCORE=$(uncore_zone || true)
+if [ -n "$UNCORE" ]; then
+    read -r gpu_range < "$UNCORE/max_energy_range_uj"
+    read -r gpu_prev < "$UNCORE/energy_uj"
+fi
+
+while :; do
+    step=$INTERVAL_AC
+    if on_battery; then step=$INTERVAL_BATTERY; fi
+    sleep "$step"
+    read -r now < "$RAPL/energy_uj"
+    delta=$(delta_of "$prev" "$now" "$range")
+    prev=$now
+    publish cpu_power $(((delta / step + MICRO / 2) / MICRO))
+    [ -n "$UNCORE" ] || continue
+    read -r gpu_now < "$UNCORE/energy_uj"
+    delta=$(delta_of "$gpu_prev" "$gpu_now" "$gpu_range")
+    gpu_prev=$gpu_now
+    publish gpu_power $(((delta / step + TENTH_WATT / 2) / TENTH_WATT * TENTH_WATT))
+done
diff --git a/quickshell/system/qs-hwinfo.service b/quickshell/system/qs-hwinfo.service
