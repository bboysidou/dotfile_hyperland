+    Process {
+        id: mpv
+        command: ["mpv", "--no-config", "--load-scripts=no", "--no-video", "--idle=yes", "--terminal=no", "--input-terminal=no", "--ytdl=yes", "--ytdl-format=234/233/bestaudio/best", "--volume=" + Math.round(root.volume * 100), "--input-ipc-server=" + root.socketPath]
