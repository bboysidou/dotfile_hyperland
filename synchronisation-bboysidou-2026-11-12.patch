+    }
+    Timer {
+        interval: 100; repeat: true; running: mpv.running && !ipc.connected
+        onTriggered: {
+            if (++root.attempts > 80) {
+                root.fail("Connexion à mpv impossible. Vérifiez mpv et l’accès au dossier XDG_RUNTIME_DIR.");
+                mpv.running = false;
+            } else ipc.connected = true;
+        }
+    }
+    Timer {
+        id: loadDeadline; interval: 90000
+        onTriggered: root.fail("YouTube ne répond pas. Vérifiez votre connexion et yt-dlp, puis réessayez.")
+    }
+}
diff --git a/quickshell/cassette/YoutubeHistory.qml b/quickshell/cassette/YoutubeHistory.qml
new file mode 100644
index 0000000..025e83c
--- /dev/null
+++ b/quickshell/cassette/YoutubeHistory.qml
@@ -0,0 +1,44 @@
+import QtQuick
+import QtCore
+import Quickshell
+import "YoutubeUrls.js" as Urls
+
+QtObject {
+    id: root
+    property var entries: []
+    property int limit: 10
+    property string category: "YouTubeHistory"
+    readonly property string storagePath: String(Quickshell.env("XDG_STATE_HOME") || (Quickshell.env("HOME") + "/.local/state")) + "/quickshell-cassette.ini"
+    readonly property Settings storage: Settings {
+        location: "file://" + root.storagePath
+        category: root.category
+    }
+    function valid(url) { return typeof url === "string" && url.length > 0 && Urls.normalize(url) === url; }
+    function restore() {
+        let values;
+        try { values = JSON.parse(String(storage.value("entries", "[]"))); } catch (_) { values = []; }
+        if (!Array.isArray(values)) values = [];
+        values = values.filter(item => item && typeof item.url === 'string').map(item => ({url: Urls.normalize(item.url), title: item.title}));
+        const seen = new Set();
+        entries = values.filter(item => {
+            if (!item || !valid(item.url) || seen.has(item.url)) return false;
+            seen.add(item.url); return true;
+        }).slice(0, limit || undefined).map(item => ({url: item.url, title: typeof item.title === "string" ? item.title : item.url}));
+    }
+    function contains(url) { return entries.some(item => item.url === url); }
+    function remove(url) { entries = entries.filter(item => item.url !== url); save(); }
+    function save() { storage.setValue("entries", JSON.stringify(entries)); storage.sync(); }
+    function remember(url) {
+        if (!valid(url)) return;
+        const previous = entries.find(item => item.url === url);
+        entries = [{url: url, title: previous ? previous.title : url}].concat(entries.filter(item => item.url !== url)).slice(0, limit || undefined);
+        save();
+    }
+    function updateTitle(url, title) {
+        if (!valid(url) || !title || title === url) return;
+        if (!entries.some(item => item.url === url)) return;
+        entries = entries.map(item => item.url === url ? {url: url, title: String(title)} : item);
+        save();
+    }
+    Component.onCompleted: restore()
+}
diff --git a/quickshell/cassette/YoutubeLibrary.qml b/quickshell/cassette/YoutubeLibrary.qml
new file mode 100644
index 0000000..1736fed
--- /dev/null
+++ b/quickshell/cassette/YoutubeLibrary.qml
@@ -0,0 +1,73 @@
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+Popup {
+    id: root
+    required property DeckController controller
+    padding: 20; modal: true; focus: true
+    background: Rectangle { color: "#20271f"; radius: 8; border.color: "#70816a" }
+    onOpened: { linkError.text = ""; linkInput.forceActiveFocus(); }
+    function submit() {
+        if (controller.openYoutube(linkInput.text)) close();
+        else linkError.text = "Collez un lien vers une vidéo ou une playlist YouTube.";
+    }
+    contentItem: ColumnLayout {
+        spacing: 12
+        Label { text: "Écouter YouTube"; color: "#d0c6ad"; font.pixelSize: 20 }
+        TextField {
+            id: linkInput; Layout.fillWidth: true
+            placeholderText: "Collez le lien complet : vidéo, playlist ou Mix"
+            color: "#d7dfcf"; placeholderTextColor: "#8b9582"; selectByMouse: true
+            background: Rectangle { color: "#121812"; radius: 4; border.color: linkInput.activeFocus ? "#8db197" : "#54604d" }
+            onAccepted: root.submit()
+        }
+        Label { text: "Collez directement le lien YouTube, en conservant list=…"; color: "#a2ac97" }
+        Label { visible: /[?&]list=RD/.test(linkInput.text); text: "Mix YouTube : jusqu’à 50 pistes par ouverture."; color: "#a2ac97" }
+        RowLayout {
+            DeckButton { text: "Historique"; onClicked: tabs.currentIndex = 0 }
+            DeckButton { text: "Favoris ★"; onClicked: tabs.currentIndex = 1 }
+        }
+        QtObject { id: tabs; property int currentIndex: 0 }
+        Label {
+            visible: library.count === 0
+            text: tabs.currentIndex ? "Aucun favori. Utilisez ☆ pour en ajouter." : "Vos 10 derniers liens apparaîtront ici."
+            color: "#a2ac97"
+        }
+        ListView {
+            id: library
+            Layout.fillWidth: true; Layout.preferredHeight: Math.min(300, contentHeight)
+            clip: true; spacing: 4
+            model: tabs.currentIndex ? root.controller.favorites : root.controller.youtubeHistory
+            delegate: RowLayout {
+                id: row
+                required property var modelData
+                width: ListView.view.width; height: 55
+                ItemDelegate {
+                    id: entry; Layout.fillWidth: true; Layout.fillHeight: true
+                    Accessible.name: "Réécouter " + row.modelData.title
+                    background: Rectangle { color: entry.hovered ? "#35422e" : "#192016"; radius: 4 }
+                    contentItem: Column {
+                        spacing: 2
+                        Label { width: parent.width; text: "▶  " + row.modelData.title; elide: Text.ElideRight; color: "#d7dfcf" }
+                        Label { width: parent.width; text: row.modelData.url; elide: Text.ElideRight; color: "#95a388"; font.pixelSize: 10 }
+                    }
+                    onClicked: { if (root.controller.openYoutube(row.modelData.url)) root.close(); }
+                }
+                DeckButton {
+                    text: root.controller.isFavorite(row.modelData.url) ? "★" : "☆"
+                    Accessible.name: root.controller.isFavorite(row.modelData.url) ? "Retirer des favoris" : "Ajouter aux favoris"
+                    onClicked: root.controller.toggleFavorite(row.modelData.url, row.modelData.title)
+                }
+            }
+            ScrollBar.vertical: ScrollBar {}
+        }
+        Label { id: linkError; Layout.fillWidth: true; wrapMode: Text.Wrap; color: "#e49b86" }
+        RowLayout {
+            Layout.alignment: Qt.AlignRight
+            DeckButton { text: "Annuler"; onClicked: root.close() }
+            DeckButton { text: "Écouter"; onClicked: root.submit() }
+        }
+    }
+}
diff --git a/quickshell/cassette/YoutubePlaylist.qml b/quickshell/cassette/YoutubePlaylist.qml
new file mode 100644
index 0000000..eaba967
--- /dev/null
+++ b/quickshell/cassette/YoutubePlaylist.qml
@@ -0,0 +1,57 @@
+import QtQuick
+import Quickshell.Io
+import "YoutubeUrls.js" as Urls
+
+Item {
+    id: root
+    property string requested: ""
+    property string launched: ""
+    property bool busy: false
+    property int generation: 0
+    property int launchedGeneration: -1
+    signal resolved(string url, string title, var entries)
+    signal failed(string url, string message)
+    function cancel() { generation++; requested = ""; busy = false; launch.stop(); deadline.stop(); worker.running = false; }
+    function open(url) { cancel(); requested = url; busy = true; launch.restart(); }
+    function arguments(url) {
+        const args = ["yt-dlp", "--ignore-config", "--yes-playlist", "--flat-playlist", "--dump-single-json", "--skip-download", "--ignore-errors", "--no-warnings", "--socket-timeout", "15", "--retries", "1"];
+        // A Mix has no stable end. Bound extraction so dump-single-json can finish.
+        if (Urls.isMix(url)) args.push("--playlist-end", "50");
+        return args.concat(["--", url]);
+    }
+    function parse(text) {
+        const data = JSON.parse(text);
+        if (!Array.isArray(data.entries)) throw Error("Playlist invalide");
+        const entries = data.entries.filter(e => e && /^[A-Za-z0-9_-]{11}$/.test(e.id || '') && e.availability !== 'private' && !/^\[(?:Deleted|Private) video\]$/.test(e.title || '')).map(e => ({url: 'https://www.youtube.com/watch?v=' + e.id, title: String(e.title || e.id)}));
+        if (!entries.length) throw Error("Aucune vidéo accessible dans cette playlist.");
+        return {title: String(data.title || 'Playlist YouTube'), entries: entries};
+    }
+    Timer {
+        id: launch; interval: 30
+        onTriggered: {
+            if (!root.requested) return;
+            if (worker.running) { restart(); return; }
+            root.launched = root.requested; root.launchedGeneration = root.generation;
+            worker.command = root.arguments(root.launched);
+            worker.running = true; deadline.restart();
+        }
+    }
+    Timer {
+        id: deadline; interval: 90000
+        onTriggered: { const url = root.requested; root.cancel(); root.failed(url, "La playlist ne répond pas. Réessayez ou vérifiez son accès."); }
+    }
+    Process {
+        id: worker
+        stdout: StdioCollector { id: output }
+        stderr: StdioCollector { id: diagnostic }
+        onExited: (code, status) => {
+            if (!root.requested || root.requested !== root.launched || root.generation !== root.launchedGeneration) return;
+            const url = root.launched;
+            deadline.stop(); root.busy = false; root.requested = "";
+            try {
+                const result = root.parse(output.text);
+                root.resolved(url, result.title, result.entries);
+            } catch (e) { root.failed(url, "Playlist : " + (code ? diagnostic.text.trim().slice(-350) || "yt-dlp indisponible ou accès refusé." : String(e))); }
+        }
+    }
+}
diff --git a/quickshell/cassette/YoutubeUrls.js b/quickshell/cassette/YoutubeUrls.js
new file mode 100644
index 0000000..fd4dd2d
--- /dev/null
+++ b/quickshell/cassette/YoutubeUrls.js
@@ -0,0 +1,26 @@
+.pragma library
+function normalize(input) {
+    const m = String(input).trim().replace(/^\+\s*(?=https?:)/, '').match(/^https?:\/\/(?:www\.|m\.|music\.)?(youtube\.com|youtu\.be)\/([^\s#]*)(?:#[^\s]*)?$/i);
+    if (!m) return "";
+    const parts = m[2].split('?');
+    const query = (parts[1] || '').split('&');
+    let id = '';
+    if (m[1].toLowerCase() === 'youtu.be') id = parts[0].split('/')[0];
+    else if (parts[0] === 'watch') { const v = query.find(p => p.startsWith('v=')); if (v) id = v.slice(2); }
+    else { const p = parts[0].match(/^(?:shorts|live|embed)\/([A-Za-z0-9_-]{11})\/?$/); if (p) id = p[1]; }
+    if (!/^[A-Za-z0-9_-]{11}$/.test(id)) id = '';
+    const list = query.find(p => p.startsWith('list='));
+    if (list && /^[A-Za-z0-9_-]{2,200}$/.test(list.slice(5))) {
+        const listId = list.slice(5);
+        // YouTube Mixes need a seed video, unlike ordinary playlist URLs.
+        if (listId.startsWith('RD')) {
+            const seed = id || (/^RD[A-Za-z0-9_-]{11}$/.test(listId) ? listId.slice(2) : '');
+            return seed ? 'https://www.youtube.com/watch?v=' + seed + '&list=' + listId : 'https://www.youtube.com/playlist?list=' + listId;
+        }
+        return 'https://www.youtube.com/playlist?list=' + listId;
+    }
+    return id ? 'https://www.youtube.com/watch?v=' + id : '';
+}
+function isPlaylist(url) { return /[?&]list=[A-Za-z0-9_-]+(?:&|$)/.test(String(url)); }
+function isMix(url) { return /[?&]list=RD[A-Za-z0-9_-]*(?:&|$)/.test(String(url)); }
+function videoId(url) { const m = String(url).match(/[?&]v=([A-Za-z0-9_-]{11})(?:&|$)/); return m ? m[1] : ''; }
