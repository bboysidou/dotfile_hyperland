diff --git a/quickshell/services/decode/caps.sh b/quickshell/services/decode/caps.sh
new file mode 100644
index 0000000..10159c1
--- /dev/null
+++ b/quickshell/services/decode/caps.sh
@@ -0,0 +1,92 @@
+#!/bin/sh
+set -u
+
+SYS="${QS_DECODE_SYSFS:-/sys}"
+DRI_DRIVERS=/usr/lib/dri
+CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/decode-caps.tsv"
+UNKNOWN=-
+NONE=none
+MODERN_CODEC=av1
+LEGACY_CODECS=" mpeg2 vc1 "
+
+codecs_of() {
+    command -v vainfo >/dev/null 2>&1 || { echo "$UNKNOWN"; return; }
+    [ -e "$1" ] || { echo "$UNKNOWN"; return; }
+    vainfo --display drm --device "$1" 2>/dev/null | awk -v none="$NONE" '
+        /VAEntrypointVLD/ {
+            if ($1 ~ /^VAProfileH264/) found["h264"] = 1
+            else if ($1 ~ /^VAProfileHEVC/) found["hevc"] = 1
+            else if ($1 ~ /^VAProfileVP8/) found["vp8"] = 1
+            else if ($1 ~ /^VAProfileVP9/) found["vp9"] = 1
+            else if ($1 ~ /^VAProfileAV1/) found["av1"] = 1
+            else if ($1 ~ /^VAProfileMPEG2/) found["mpeg2"] = 1
+            else if ($1 ~ /^VAProfileVC1/) found["vc1"] = 1
+        }
+        END {
+            n = split("h264 hevc vp8 vp9 av1 mpeg2 vc1", order, " ")
+            out = ""
+            for (i = 1; i <= n; i++) if (order[i] in found) out = out (out == "" ? "" : ",") order[i]
+            print out == "" ? none : out
+        }'
+}
+
+cache_key() {
+    printf '%s:%s:%s' "$(cat "$1/vendor" 2>/dev/null)" "$(cat "$1/device" 2>/dev/null)" "$(stat -c %Y "$DRI_DRIVERS" 2>/dev/null)"
+}
+
+cached() {
+    [ -r "$CACHE" ] && awk -F'\t' -v pci="$1" -v key="$2" '$1 == pci && $2 == key { print $3; exit }' "$CACHE"
+}
+
+remember() {
+    mkdir -p "${CACHE%/*}"
+    { [ -r "$CACHE" ] && awk -F'\t' -v pci="$1" '$1 != pci' "$CACHE"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } >"$CACHE.tmp" && mv -f "$CACHE.tmp" "$CACHE"
+}
+
+cards() {
+    for dev in "$SYS"/bus/pci/devices/*; do
+        case "$(cat "$dev/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
+        pci=${dev##*/}
+        key=$(cache_key "$dev")
+        codecs=$(cached "$pci" "$key")
+        if [ -z "$codecs" ] && [ "$(cat "$dev/power/runtime_status" 2>/dev/null)" != suspended ]; then
+            node=$(ls -d "$dev"/drm/renderD* 2>/dev/null | head -n 1)
+            codecs=$([ -n "$node" ] && codecs_of "/dev/dri/${node##*/}" || echo "$UNKNOWN")
+            [ "$codecs" != "$UNKNOWN" ] && remember "$pci" "$key" "$codecs"
+        fi
+        printf '%s\t%s\n' "$pci" "${codecs:-$UNKNOWN}"
+    done
+}
+
+covers() {
+    case ",$1," in *",$2,"*) return 0 ;; esac
+    return 1
+}
+
+should_pin() {
+    integrated=$(codecs_of "$1")
+    dedicated=$(codecs_of "$2")
+    case "$integrated" in "$UNKNOWN" | "$NONE") return 1 ;; esac
+    case "$dedicated" in
+        "$NONE") return 0 ;;
+        "$UNKNOWN")
+            covers "$integrated" "$MODERN_CODEC"
+            return
+            ;;
+    esac
+    for codec in $(printf '%s' "$dedicated" | tr ',' ' '); do
+        case "$LEGACY_CODECS" in *" $codec "*) continue ;; esac
+        covers "$integrated" "$codec" || return 1
+    done
+    return 0
+}
+
+case "${1:-}" in
+    cards) cards ;;
+    node) codecs_of "${2:-}" ;;
+    pin) should_pin "${2:-}" "${3:-}" ;;
+    *)
+        echo "usage: caps.sh cards | node RENDER_NODE | pin IGPU_NODE DGPU_NODE" >&2
+        exit 2
+        ;;
+esac
diff --git a/quickshell/services/decode/decode.sh b/quickshell/services/decode/decode.sh
new file mode 100644
index 0000000..d9becb2
--- /dev/null
+++ b/quickshell/services/decode/decode.sh
@@ -0,0 +1,144 @@
+#!/bin/sh
+set -u
+
+SYS="${QS_DECODE_SYSFS:-/sys}"
+PROC="${QS_DECODE_PROCFS:-/proc}"
+SAMPLE_SECONDS="${QS_DECODE_SAMPLE:-1}"
+CPU_MIN_PERCENT=5
+THREAD_PATTERN='^(av:[^:]+:(df|sw)[0-9]+|dav1d-worker|CodecWorker)$'
+NVIDIA_VENDOR=0x10de
+
+ticks_per_second() {
+    getconf CLK_TCK 2>/dev/null || echo 100
+}
+
+now_ns() {
+    date +%s%N
+}
+
+decoder_threads() {
+    grep -sE "$THREAD_PATTERN" "$PROC"/[0-9]*/task/*/comm | while IFS=: read -r path name; do
+        task=${path%/comm}
+        rest=${path#"$PROC"/}
+        stat=$(cat "$task/stat" 2>/dev/null) || continue
+        case "$name" in
+            dav1d-worker) codec=av1 ;;
+            CodecWorker) codec=vpx ;;
+            *) codec=${name#av:}; codec=${codec%%:*} ;;
+        esac
+        printf '%s %s %s %s %s\n' "$1" "${rest%%/*}" "${task##*/}" "$codec" "$(printf '%s' "${stat##*) }" | awk '{ print $12 + $13 }')"
+    done
+}
+
+video_engines() {
+    find "$PROC"/[0-9]*/fd -lname '/dev/dri/*' 2>/dev/null | sed 's|/fd/|/fdinfo/|' | xargs -r awk -v tag="$1" '
+        function flush() {
+            if (client != "" && pdev != "" && !seen[pid SUBSEP pdev SUBSEP client]++) {
+                key = pid SUBSEP pdev
+                work[key] += busy
+                span[key] += total
+                if (kind != "") kinds[key] = kind
+            }
+            client = ""
+        }
+        FNR == 1 { flush(); n = split(FILENAME, part, "/"); pid = part[n - 2]; client = pdev = kind = ""; busy = total = 0 }
+        /^drm-client-id:/ { client = $2 }
+        /^drm-pdev:/ { pdev = $2 }
+        /^drm-engine-(dec|enc|jpeg|vcn|video)[^:]*:/ { busy += $2; kind = "ns" }
+        /^drm-cycles-vcs:/ { busy += $2; kind = "cycles" }
+        /^drm-total-cycles-vcs:/ { total += $2 }
+        END {
+            flush()
+            for (key in work) {
+                if (!(key in kinds)) continue
+                split(key, field, SUBSEP)
+                printf "%s %s %s %s %.0f %.0f\n", tag, field[1], field[2], kinds[key], work[key], span[key]
+            }
+        }' 2>/dev/null
+}
+
+nvidia_cards() {
+    for dev in "$SYS"/bus/pci/devices/*; do
+        [ "$(cat "$dev/vendor" 2>/dev/null)" = "$NVIDIA_VENDOR" ] || continue
+        case "$(cat "$dev/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
+        [ "$(cat "$dev/power/runtime_status" 2>/dev/null)" = suspended ] && continue
+        echo "${dev##*/}"
+    done
+}
+
+nvidia_decoders() {
+    command -v nvidia-smi >/dev/null 2>&1 || return 0
+    for pci in $(nvidia_cards); do
+        nvidia-smi pmon -i "$pci" -c 1 -s u 2>/dev/null | awk -v pci="$pci" '
+            /^# *gpu/ { for (i = 2; i <= NF; i++) column[$i] = i - 1; next }
+            /^#/ || !("dec" in column) { next }
+            $column["pid"] ~ /^[0-9]+$/ && $column["dec"] ~ /^[0-9]+$/ && $column["dec"] > 0 {
+                printf "n %s %s %s\n", $column["pid"], pci, $column["dec"]
+            }'
+    done
+}
+
+summarise() {
+    awk -v ticks="$(ticks_per_second)" -v cpuMin="$CPU_MIN_PERCENT" '
+        $1 == "e" { elapsed = $2; next }
+        $1 == "ta" { before[$3] = $5; next }
+        $1 == "tb" {
+            if (!($2 in codecs)) codecs[$2] = $4
+            if (!($3 in before) || $5 < before[$3]) next
+            spent = $5 - before[$3]
+            cpu[$2] += spent
+            if (spent > best[$2]) { best[$2] = spent; codecs[$2] = $4 }
+            next
+        }
+        $1 == "va" { vwork[$2 SUBSEP $3] = $5; vspan[$2 SUBSEP $3] = $6; next }
+        $1 == "vb" {
+            key = $2 SUBSEP $3
+            if (!(key in vwork)) next
+            work = $5 - vwork[key]
+            span = $4 == "cycles" ? $6 - vspan[key] : elapsed
+            if (work > 0 && span > 0) gpu[key] = work / span * 100
+            next
+        }
+        $1 == "n" { gpu[$2 SUBSEP $3] = $4; next }
+        END {
+            seconds = elapsed / 1000000000
+            for (pid in cpu) {
+                percent = seconds > 0 ? cpu[pid] / ticks / seconds * 100 : 0
+                if (percent >= cpuMin) printf "cpu %s %s - %.0f\n", pid, codecs[pid], percent
+            }
+            for (key in gpu) {
+                split(key, field, SUBSEP)
+                load = gpu[key] > 100 ? 100 : gpu[key] < 1 ? 1 : gpu[key]
+                printf "gpu %s %s %s %.0f\n", field[1], (field[1] in codecs ? codecs[field[1]] : "-"), field[2], load
+            }
+        }'
+}
+
+app_of() {
+    exe=$(readlink "$PROC/$1/exe" 2>/dev/null)
+    name=${exe##*/}
+    [ -n "$name" ] || name=$(cat "$PROC/$1/comm" 2>/dev/null)
+    printf '%s' "${name%-bin}"
+}
+
+scan() {
+    start=$(now_ns)
+    threads_a=$(decoder_threads ta)
+    video_a=$(video_engines va)
+    sleep "$SAMPLE_SECONDS"
+    middle=$(now_ns)
+    threads_b=$(decoder_threads tb)
+    video_b=$(video_engines vb)
+    printf '%s\n' "e $((middle - start))" "$threads_a" "$threads_b" "$video_a" "$video_b" "$(nvidia_decoders)" | grep -v '^$' | summarise |
+        while read -r kind pid codec pci load; do
+            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$kind" "$pid" "$(app_of "$pid")" "$codec" "$pci" "$load"
+        done
+}
+
+case "${1:-}" in
+    scan) scan ;;
+    *)
+        echo "usage: decode.sh scan" >&2
+        exit 2
+        ;;
+esac
diff --git a/quickshell/services/gpu/gpu.sh b/quickshell/services/gpu/gpu.sh
new file mode 100755
index 0000000..012fa71
--- /dev/null
+++ b/quickshell/services/gpu/gpu.sh
@@ -0,0 +1,252 @@
+#!/bin/sh
+set -u
+
+SYS="${QS_GPU_SYSFS:-/sys}"
+PROC="${QS_GPU_PROCFS:-/proc}"
+HWINFO="${QS_GPU_HWINFO:-/run/qs-hw}"
+PCI_IDS=/usr/share/hwdata/pci.ids
+MIB=1048576
+MICRO=1000000
+MILLI=1000
+NVIDIA_QUERY=utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,power.limit,fan.speed,clocks.gr
+
+value() {
+    cat "$1" 2>/dev/null || echo -
+}
+
+first_value() {
+    dir=$1
+    shift
+    [ -n "$dir" ] || { echo -; return; }
+    for file; do
+        [ -r "$dir/$file" ] && { cat "$dir/$file"; return; }
+    done
+    echo -
+}
+
+intel_integrated() {
+    case "$1" in *:00:02.0) return 0 ;; esac
+    return 1
+}
+
+discrete_of() {
+    case "$1" in
+        nvidia | nouveau | "") echo 1 ;;
+        i915 | xe) if intel_integrated "$2"; then echo 0; else echo 1; fi ;;
+    esac
+}
+
+state_of() {
+    cat "$1/power/runtime_status" 2>/dev/null
+}
+
+has_smi() {
+    command -v nvidia-smi >/dev/null 2>&1
+}
+
+pci_name() {
+    vendor=$(cut -c3- "$1/vendor" 2>/dev/null)
+    device=$(cut -c3- "$1/device" 2>/dev/null)
+    sed -n "/^$vendor  /,/^[0-9a-f]/s/^\t$device  //p" "$PCI_IDS" 2>/dev/null | head -n 1
+}
+
+missing_for() {
+    case "$1" in
+        nvidia) has_smi || echo nvidia-utils ;;
+        nouveau | "") echo nvidia-driver ;;
+    esac
+}
+
+probe() {
+    for dev in "$SYS"/bus/pci/devices/*; do
+        class=$(cat "$dev/class" 2>/dev/null) || continue
+        case "$class" in 0x03*) ;; *) continue ;; esac
+        driver=$(basename "$(readlink "$dev/driver" 2>/dev/null)" 2>/dev/null)
+        vendor=$(cat "$dev/vendor" 2>/dev/null)
+        state=$(state_of "$dev")
+        vram=""
+        name=""
+        case "$driver" in
+            amdgpu)
+                vram=$(cat "$dev/mem_info_vram_total" 2>/dev/null)
+                ;;
+            nvidia)
+                if [ "$state" != suspended ] && has_smi; then
+                    info=$(nvidia-smi -i "${dev##*/}" --query-gpu=memory.total,name --format=csv,noheader,nounits 2>/dev/null | head -n 1)
+                    mib=$(printf '%s' "${info%%,*}" | tr -d ' ')
+                    case "$mib" in *[!0-9]* | "") ;; *) vram=$((mib * MIB)) ;; esac
+                    case "$info" in *,*) name=$(printf '%s' "${info#*,}" | sed 's/^ *//; s/^NVIDIA //') ;; esac
+                fi
+                ;;
+            i915 | xe | nouveau | radeon) ;;
+            "") [ "$vendor" = 0x10de ] || continue ;;
+            *) continue ;;
+        esac
+        hwmon=$(ls -d "$dev"/hwmon/hwmon* 2>/dev/null | head -n 1)
+        [ -n "$name" ] || name=$(cat "$dev/product_name" 2>/dev/null)
+        [ -n "$name" ] || name=$(pci_name "$dev")
+        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$dev" "$hwmon" "${dev##*/}" "$vram" "$state" "$name" "${driver:-none}" "$(missing_for "$driver")" "$(discrete_of "$driver" "${dev##*/}")"
+    done
+}
+
+fdinfo_scan() {
+    find "$PROC"/[0-9]*/fd -lname '/dev/dri/*' 2>/dev/null | sed 's|/fd/|/fdinfo/|' | xargs -r awk -v want="$1" -v proc="$PROC" '
+        function kib(amount, unit) {
+            if (unit == "MiB") return amount * 1024
+            if (unit == "GiB") return amount * 1048576
+            if (unit == "B" || unit == "") return amount / 1024
+            return amount
+        }
+        function flush() {
+            if (client != "" && (want == "" || pdev == "" || pdev == want) && !seen[pid SUBSEP pdev SUBSEP client]++) {
+                busy[pid] += work
+                span[pid] += total
+                mem[pid] += memory > 0 ? memory : shared
+                local[pid] += memory
+                if (kind != "") kinds[pid] = kind
+            }
+            client = ""
+        }
+        FNR == 1 { flush(); n = split(FILENAME, part, "/"); pid = part[n - 2]; client = pdev = kind = ""; work = total = memory = shared = 0 }
+        /^drm-client-id:/ { client = $2 }
+        /^drm-pdev:/ { pdev = $2 }
+        /^drm-engine-(gfx|render):/ { work = $2; kind = "ns" }
+        /^drm-cycles-rcs:/ { work = $2; kind = "cycles" }
+        /^drm-total-cycles-rcs:/ { total = $2 }
+        /^drm-(memory|resident)-(vram|local0)/ { memory = kib($2, $3) }
+        /^drm-resident-system0?:/ { shared = kib($2, $3) }
+        END {
+            flush()
+            for (id in busy) {
+                path = proc "/" id "/comm"
+                name = ""
+                getline name < path
+                close(path)
+                printf "%s\t%s\t%d\t%d\t%d\t%d\t%s\n", id, (id in kinds ? kinds[id] : "ns"), busy[id], span[id], mem[id], local[id], name
+            }
+        }' 2>/dev/null
+}
+
+local_vram() {
+    awk -F'\t' '{ kib += $6 } END { printf "%d\n", kib * 1024 }'
+}
+
+counters() {
+    awk -F'\t' '
+        { kind = $2; work += $3; total += $4 }
+        END { if (kind == "") print "-"; else printf "%s\t%d\t%d\n", kind, work, total }'
+}
+
+nvidia_readings() {
+    if ! has_smi; then
+        printf -- '-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n'
+        return
+    fi
+    nvidia-smi -i "$1" --query-gpu="$NVIDIA_QUERY" --format=csv,noheader,nounits 2>/dev/null | head -n 1 | awk -F', *' -v mib="$MIB" -v micro="$MICRO" -v milli="$MILLI" '
+        function num(text) { return text ~ /^[0-9.]+$/ }
+        function out(text, scale) { if (num(text)) printf "%.0f\n", text * scale; else print "-" }
+        {
+            out($1, 1); out($2, mib); out($3, mib); out($4, milli)
+            out($5, micro); print "-"; out($6, micro)
+            out($7, 1); print (num($7) ? 100 : "-"); print "-"
+            out($8, micro)
+        }
+        END { if (NR == 0) for (i = 0; i < 11; i++) print "-" }'
+}
+
+intel_clock() {
+    for file in "$1"/drm/card*/gt_act_freq_mhz "$1"/tile0/gt0/freq0/act_freq; do
+        [ -r "$file" ] || continue
+        echo $(($(cat "$file") * MICRO))
+        return
+    done
+    echo -
+}
+
+hwmon_readings() {
+    first_value "$1" temp1_input temp2_input
+    if [ -n "${2:-}" ]; then first_value "$HWINFO" "$2"; else first_value "$1" power1_input; fi
+    first_value "$1" power1_average
+    first_value "$1" power1_cap power1_max
+    first_value "$1" pwm1
+    first_value "$1" pwm1_max
+    first_value "$1" fan1_input
+}
+
+read_card() {
+    driver=$1 dev=$2 hwmon=$3 pci=$4
+    if [ "$(state_of "$dev")" = suspended ]; then
+        echo suspended
+        return
+    fi
+    echo active
+    case "$driver" in
+        amdgpu)
+            for file in gpu_busy_percent mem_info_vram_used mem_info_vram_total; do value "$dev/$file"; done
+            hwmon_readings "$hwmon"
+            first_value "$hwmon" freq1_input
+            echo -
+            ;;
+        radeon)
+            printf -- '-\n-\n-\n'
+            hwmon_readings "$hwmon"
+            first_value "$hwmon" freq1_input
+            echo -
+            ;;
+        nvidia)
+            nvidia_readings "$pci"
+            echo -
+            ;;
+        i915 | xe)
+            scan=$(fdinfo_scan "$pci")
+            echo -
+            if intel_integrated "$pci"; then
+                echo -
+                echo -
+                hwmon_readings "$hwmon" gpu_power
+            else
+                printf '%s' "$scan" | local_vram
+                echo -
+                hwmon_readings "$hwmon"
+            fi
+            intel_clock "$dev"
+            printf '%s' "$scan" | counters
+            first_value "$hwmon" energy1_input
+            ;;
+    esac
+}
+
+nvidia_processes() {
+    has_smi || return 0
+    nvidia-smi pmon -i "$1" -c 1 -s um 2>/dev/null | awk '
+        /^# *gpu/ { for (i = 2; i <= NF; i++) column[$i] = i - 1; next }
+        /^#/ || !("pid" in column) { next }
+        $column["pid"] ~ /^[0-9]+$/ {
+            sm = $column["sm"]; fb = $column["fb"]
+            name = $column["command"]
+            for (i = column["command"] + 1; i <= NF; i++) name = name " " $i
+            kib = fb ~ /^[0-9]+$/ ? fb * 1024 : 0
+            printf "%s\tpct\t%d\t0\t%d\t%d\t%s\n", $column["pid"], (sm ~ /^[0-9]+$/ ? sm : 0), kib, kib, name
+        }'
+}
+
+processes() {
+    driver=$1 dev=$2 pci=$3
+    [ "$(state_of "$dev")" = suspended ] && return 0
+    case "$driver" in
+        nvidia) nvidia_processes "$pci" ;;
+        amdgpu | i915 | xe) fdinfo_scan "$pci" ;;
+    esac
+}
+
+command=${1:-}
+[ $# -gt 0 ] && shift
+case "$command" in
+    probe) probe ;;
+    read) read_card "$@" ;;
+    procs) processes "$@" ;;
+    *)
+        echo "usage: gpu.sh probe | read DRIVER DEVICE HWMON PCI | procs DRIVER DEVICE PCI" >&2
+        exit 2
+        ;;
+esac
diff --git a/quickshell/services/speedtest/net_speedtest.sh b/quickshell/services/speedtest/net_speedtest.sh
new file mode 100755
index 0000000..34be00b
--- /dev/null
+++ b/quickshell/services/speedtest/net_speedtest.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+set -u
+
+direction="${1:-}"
+duration="${2:-8}"
+probe=1.1.1.1
+parallel=8
+url_count=3
+upload_chunk_bytes=$((32 * 1024 * 1024))
+fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
+fast_api="https://api.fast.com/netflix/speedtest/v2?https=true&token=${fast_token}&urlCount=${url_count}"
+
+case "$direction" in
+    down) counter=rx_bytes ;;
+    up) counter=tx_bytes ;;
+    *)
+        echo "usage: net_speedtest.sh down|up [seconds]" >&2
+        exit 2
+        ;;
+esac
+
+if [[ ! $duration =~ ^[1-9][0-9]*$ ]]; then
+    echo "Invalid duration: $duration" >&2
+    exit 2
+fi
+
+iface=$(ip route get "$probe" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
+stats="/sys/class/net/${iface}/statistics/${counter}"
+
+if [[ -z $iface || ! -r $stats ]]; then
+    echo "No active network interface" >&2
+    exit 1
+fi
+
+mapfile -t urls < <(curl -fsS --max-time 10 "$fast_api" 2>/dev/null | jq -r '.targets[]?.url // empty' 2>/dev/null)
+
+if (( ${#urls[@]} == 0 )); then
+    echo "Could not reach fast.com" >&2
+    exit 1
+fi
+
+workers=()
+
+cleanup() {
+    local pid
+    for pid in "${workers[@]}"; do
+        pkill -TERM -P "$pid" 2>/dev/null
+        kill "$pid" 2>/dev/null
+    done
+    wait 2>/dev/null
+}
+
+trap cleanup EXIT
+trap 'exit 143' TERM INT HUP
+
+worker() {
+    local idx=$RANDOM url
+    while true; do
+        url=${urls[idx % ${#urls[@]}]}
+        if [[ $direction == down ]]; then
+            curl -fsS -o /dev/null "$url" 2>/dev/null || return
+        else
+            head -c "$upload_chunk_bytes" /dev/zero | curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return
+        fi
+        idx=$((idx + 1))
+    done
+}
+
+alive() {
+    local pid
+    for pid in "${workers[@]}"; do
+        kill -0 "$pid" 2>/dev/null && return 0
+    done
+    return 1
+}
+
+for (( i = 0; i < parallel; i++ )); do
+    worker &
+    workers+=("$!")
+done
+
+before=$(<"$stats")
+started=$EPOCHREALTIME
+
+for (( second = 0; second < duration; second++ )); do
+    sleep 1
+    if ! alive; then
+        echo "Lost connection to the test server" >&2
+        exit 1
+    fi
+    after=$(<"$stats")
+    now=$EPOCHREALTIME
+    awk -v before="$before" -v after="$after" -v from="$started" -v to="$now" 'BEGIN {
+        elapsed = to - from
+        bits = after > before ? (after - before) * 8 : 0
+        printf "%.2f\n", (elapsed > 0 ? bits / elapsed / 1000000 : 0)
+    }'
+    before=$after
+    started=$now
+done
