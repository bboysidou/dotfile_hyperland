+        component: PrayerCenter {}
+    }
+
+    IpcHandler {
+        target: "prayerControl"
+        function status(): string {
+            return `enabled=${Prefs.prayersEnabled} loaded=${root.active} ready=${Prayer.backend ? Prayer.backend.ready : false}`;
