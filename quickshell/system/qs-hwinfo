#!/bin/sh
set -eu

OUT="${RUNTIME_DIRECTORY:-/run/qs-hw}"
RAPL=/sys/class/powercap/intel-rapl:0
SUPPLIES=/sys/class/power_supply
INTERVAL_AC=2
INTERVAL_BATTERY=6
MICRO=1000000

publish() {
    printf '%s\n' "$2" > "$OUT/$1.tmp"
    mv -f "$OUT/$1.tmp" "$OUT/$1"
}

dimms() {
    dmidecode -t memory | awk -F': ' '
        function flush() {
            if (size ~ /^[0-9]/)
                printf "%s\t%s\t%s\t%s\n", loc, size, type, (configured != "" ? configured : speed)
            loc = size = type = speed = configured = ""
        }
        /^Memory Device/ { flush(); next }
        { sub(/^[ \t]+/, "") }
        $1 == "Locator" { loc = $2 }
        $1 == "Size" { size = $2 }
        $1 == "Type" { type = $2 }
        $1 == "Speed" { speed = $2 }
        $1 == "Configured Memory Speed" { configured = $2 }
        END { flush() }'
}

on_battery() {
    mains=0
    for supply in "$SUPPLIES"/*; do
        read -r kind 2>/dev/null < "$supply/type" || continue
        [ "$kind" = Mains ] || continue
        read -r online 2>/dev/null < "$supply/online" || continue
        [ "$online" = 1 ] && return 1
        mains=1
    done
    [ "$mains" = 1 ]
}

umask 022
mkdir -p "$OUT"
publish dimms.tsv "$(dimms)"

[ -r "$RAPL/energy_uj" ] || exit 0

read -r range < "$RAPL/max_energy_range_uj"
read -r prev < "$RAPL/energy_uj"

while :; do
    step=$INTERVAL_AC
    if on_battery; then step=$INTERVAL_BATTERY; fi
    sleep "$step"
    read -r now < "$RAPL/energy_uj"
    delta=$((now - prev))
    [ "$delta" -lt 0 ] && delta=$((delta + range))
    prev=$now
    publish cpu_power $(((delta / step + MICRO / 2) / MICRO))
done
